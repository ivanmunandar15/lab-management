# Buat secret: npx auth secret   (atau: openssl rand -base64 32)
AUTH_SECRET="0d25dea6f8dfd6f670c38090fab610ae5d86e9bfb0d1d670bd550d6c7d39943ad197784f7d7a2baa413bb5553e534f7b"
AUTH_TRUST_HOST=true

# Backend Express (hanya dibaca server Next.js: login, refresh token, dan proxy /api/proxy).
# Jangan beri prefix NEXT_PUBLIC_. Frontend dijalankan di port 3001: npm run dev -- -p 3001
API_URL=http://localhost:3000/api/v1

# Opsional: basis URL yang di-encode ke QR code (default: origin browser)
NEXT_PUBLIC_APP_URL=
